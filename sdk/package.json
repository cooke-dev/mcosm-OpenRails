{
  "name": "openrails-sdk",
  "version": "0.1.2",
  "description": "OpenRails SDK and CLI for bounded, intent-driven settlement on EVM networks, including the canonical GIWA Sepolia deployment.",
  "license": "MIT",
  "homepage": "https://openrails.pages.dev",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/ethers": {
      "types": "./dist/adapters/ethers.d.ts",
      "default": "./dist/adapters/ethers.js"
    },
    "./adapters/privy": {
      "types": "./dist/adapters/privy.d.ts",
      "default": "./dist/adapters/privy.js"
    },
    "./adapters/turnkey": {
      "types": "./dist/adapters/turnkey.d.ts",
      "default": "./dist/adapters/turnkey.js"
    },
    "./adapters/circle": {
      "types": "./dist/adapters/circle.d.ts",
      "default": "./dist/adapters/circle.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openrails": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openrails",
    "arc",
    "x402",
    "usdc",
    "streaming-payments",
    "nanopayments",
    "eip-712",
    "agent-payments",
    "giwa",
    "mcp",
    "programmable-payments"
  ],
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependencies": {
    "@privy-io/react-auth": ">=1",
    "@turnkey/ethers": ">=1"
  },
  "peerDependenciesMeta": {
    "@privy-io/react-auth": {
      "optional": true
    },
    "@turnkey/ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12"
  }
}
