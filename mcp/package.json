{
  "name": "openrails-mcp",
  "version": "0.3.0",
  "description": "GIWA-safe OpenRails MCP server for canonical reads, unsigned RailsFlow preparation, and the non-custodial Agent Kernel.",
  "license": "MIT",
  "homepage": "https://openrails.pages.dev",
  "type": "module",
  "bin": { "openrails-mcp": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build:kernel": "npm run build --prefix ../agent-kernel",
    "build": "npm run build:kernel && tsc -p tsconfig.json",
    "smoke": "npm run build && node smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openrails",
    "mcp",
    "model-context-protocol",
    "giwa",
    "programmable-payments",
    "agent-payments",
    "path",
    "pact",
    "gaia",
    "eip-712"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ethers": "^6.13.0",
    "openrails-sdk": "^0.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12"
  }
}
