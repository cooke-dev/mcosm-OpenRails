{
  "name": "openrails-v1-substrate",
  "version": "1.0.0",
  "private": true,
  "description": "OpenRails \u2014 GIWA-native bounded payment and agent coordination infrastructure. The deployed rail remains the custody boundary; the Agent Kernel adds Workspace, Path, Pact, Proof, BNH runtime, and Gaia.",
  "main": "sdk/dist/index.js",
  "types": "sdk/dist/index.d.ts",
  "bin": {
    "openrails": "sdk/dist/cli.js"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:foundry": "forge test",
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "node": "hardhat node",
    "server": "ts-node server/index.ts",
    "start": "concurrently \"npm run node\" \"npm run server\"",
    "dev": "npm --prefix apps/gasok-web run dev",
    "stream-gateway": "ts-node stream-gateway/index.ts",
    "launch:check": "ts-node scripts/launch-check.ts",
    "smoke:x402:paid": "ts-node experiments/x402-smoke/x402-paid-buyer.ts",
    "smoke:x402:stream": "ts-node experiments/x402-smoke/x402-to-stream.ts",
    "bots:wallets": "ts-node scripts/gen-bot-wallets.ts",
    "bots:run": "ts-node experiments/traction-bots/run-bots.ts",
    "settler:wallet": "ts-node scripts/gen-settler-wallet.ts",
    "faucet:wallet": "ts-node scripts/gen-faucet-wallet.ts",
    "deploy:giwa": "hardhat run scripts/deploy-giwa-openrails.ts --network giwaSepolia",
    "verify:giwa": "hardhat run scripts/verify-giwa-deployment.ts --network giwaSepolia",
    "check:giwa": "hardhat run scripts/check-giwa-network.ts --network giwaSepolia",
    "recover:giwa": "hardhat run scripts/recover-giwa-deployment.ts --network giwaSepolia",
    "test:giwa-sdk": "hardhat test test/OpenRailsGiwaSdkMcp.test.ts",
    "build:mcp": "npm run build --prefix mcp",
    "smoke:mcp": "npm run smoke --prefix mcp",
    "mcp:giwa": "node mcp/dist/index.js",
    "build:agent-kernel": "npm run build --prefix agent-kernel",
    "test:agent-kernel": "npm run test --prefix agent-kernel",
    "check:agent-kernel": "npm run check --prefix agent-kernel",
    "agent-kernel:start": "npm run start --prefix agent-kernel",
    "verify:giwa-agent-kernel": "npm run check:agent-kernel && npm run build:mcp && npm run smoke:mcp && npm run test:giwa-sdk && npm run test",
    "deploy:giwa-faucet": "npm run compile && ts-node scripts/deploy-giwa-orusd-faucet.ts",
    "verify:giwa-faucet": "npm run compile && ts-node scripts/verify-giwa-orusd-faucet.ts",
    "web:dev": "npm --prefix apps/gasok-web run dev",
    "web:typecheck": "npm --prefix apps/gasok-web run typecheck",
    "web:build": "npm --prefix apps/gasok-web run build",
    "web:start": "npm --prefix apps/gasok-web run start",
    "legacy:arc:smoke:sdk": "ts-node scripts/sdk-arc-smoke.ts",
    "legacy:arc:cockpit:dev": "npm --prefix cockpit run dev",
    "legacy:arc:cockpit:build": "npm --prefix cockpit run build",
    "legacy:arc:cockpit:deploy": "npm --prefix cockpit run build && npx wrangler pages deploy cockpit/dist --project-name openrails --branch main",
    "legacy:arc:deploy": "hardhat run scripts/deploy-openrails.ts --network arcTestnet",
    "legacy:arc:smoke:testnet": "hardhat run scripts/smoke-openrails-testnet.ts --network arcTestnet"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.2.0",
    "@openzeppelin/contracts": "5.1.0",
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "concurrently": "^8.2.2",
    "hardhat": "^2.22.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
